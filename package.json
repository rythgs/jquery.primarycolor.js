{
  "name": "jquery.primarycolor.js",
  "version": "3.0.0",
  "description": "Detect the primary color of an image with a modern API and jQuery plugin adapter.",
  "keywords": [
    "color",
    "jquery",
    "plugin"
  ],
  "homepage": "https://github.com/rythgs/jquery.primarycolor.js#readme",
  "bugs": {
    "url": "https://github.com/rythgs/jquery.primarycolor.js/issues"
  },
  "license": "MIT",
  "author": "rythgs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rythgs/jquery.primarycolor.js.git"
  },
  "source": "src/index.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/jquery.js",
    "./dist/jquery.primarycolor.umd.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "jquery": [
        "./dist/jquery.d.ts"
      ]
    }
  },
  "unpkg": "./dist/jquery.primarycolor.umd.js",
  "jsdelivr": "./dist/jquery.primarycolor.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jquery": {
      "types": "./dist/jquery.d.ts",
      "default": "./dist/jquery.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "ci": "bun run lint && bun run test && bun run build && bun run test:dist && bun run test:umd && bun run lint:package",
    "fix": "oxlint --fix && oxfmt",
    "lint": "oxlint && oxfmt --check && tsc --noEmit",
    "lint:package": "publint --strict && attw --pack . --ignore-rules cjs-resolves-to-esm",
    "lint:type": "tsc --noEmit",
    "test": "vitest run --exclude \"test/**/*.test.ts\"",
    "test:dist": "vitest run test/dist.test.ts",
    "test:umd": "vitest run test/umd.test.ts",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/jquery": "4.0.1",
    "@types/node": "26.6.6",
    "jquery": "4.0.0",
    "jsdom": "31.0.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "jquery": ">=3 <5"
  },
  "peerDependenciesMeta": {
    "jquery": {
      "optional": true
    }
  },
  "packageManager": "bun@1.4.4"
}
